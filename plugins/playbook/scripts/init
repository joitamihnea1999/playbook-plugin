#!/bin/bash
# scripts/init — mechanical project setup for playbook plugin
#
# Creates the agent state dirs (.agent/, or .agent/<user>/ in a multi-user
# repo), .claude/bin/ wrappers, settings.json permissions,
# and MIND_MAP.md stub. Safe to re-run (idempotent).
#
# Usage: scripts/init [project-display-name]
#   Operates on cwd (assumes cwd = target project root).
#   $1 = optional display name for MIND_MAP.md (default: basename of cwd).

set -e

# Source shared lib (same directory as this script)
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/gate-echo-lib.sh"

PROJECT_DIR="$PWD"

# $1 is a free-text display name, so an unrecognised FLAG would otherwise be
# adopted as the project's name and written into MIND_MAP.md — while init went
# ahead and provisioned, including the global touches (~/.profile, ~/.claude).
# An inspection flag must never mutate anything: answer it and exit.
case "${1-}" in
    -h|--help)
        cat <<'USAGE'
Usage: init [project-display-name]

Mechanical project setup for the playbook plugin. Operates on the current
directory (assumed to be the project root) and is safe to re-run — existing
files are reported as skipped, not overwritten.

  project-display-name   Title used in MIND_MAP.md (default: basename of cwd).

Provisions: .agent/ state dirs (or .agent/<user>/ in a multi-user repo),
.claude/bin/ wrappers, settings.json permissions, CLAUDE.md, MIND_MAP.md stub,
the monitor scaffold, and the shell bash-log hookup.

Normally invoked for you by /playbook:init.
USAGE
        exit 0
        ;;
    -*)
        echo "init: unknown option '$1'" >&2
        echo "The only argument is an optional project display name. See: init --help" >&2
        exit 2
        ;;
esac

# Playbook runtime is stdlib-only — any python3 ≥ 3.10 works. init shells out to
# python3 (settings merge, claude-md-merge.py) and provisions state a < 3.10
# interpreter could not run; refuse early, before any provisioning, with a clear
# message instead of a mid-run parser traceback. (--help above stays python-free.)
# See CLAUDE.md "Runtime invariant" and memory project-stdlib-only-runtime.
python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3,10) else 1)' 2>/dev/null \
    || { echo "Playbook needs python3 >= 3.10 (found: $(python3 --version 2>&1))" >&2; exit 1; }

PROJECT_NAME="${1:-$(basename "$PWD")}"

# Everything init provisions is per-user runtime state, so it belongs in the
# lane this clone has selected — `.agent/` on a single-user repo (unchanged),
# `.agent/<user>/` where a marker exists. require_lane_marker stops us from
# creating a phantom root lane on a fresh clone of a multi-user repo, where the
# lanes are present but the gitignored marker is not.
require_lane_marker "$PROJECT_DIR" "playbook init"
AGENT_DIR="$(resolve_agent_dir "$PROJECT_DIR")"
# Label paths relative to the project in the created/skipped summary.
AGENT_REL="${AGENT_DIR#"$PROJECT_DIR"/}"

# Resolve the host-shell rc file up front. It is one of the files the snapshot
# below must protect, and the choice depends only on $SHELL / $HOME — nothing
# init has created yet — so it is safe to decide here. (Section (e) reuses
# RC_FILE and SOURCE_LINE; they are set once, here.)
SHELL_NAME="$(basename "$SHELL" 2>/dev/null)"
if [ "$SHELL_NAME" = "zsh" ]; then
    RC_FILE="$HOME/.zshenv"
    SOURCE_LINE='[ -f ~/.claude/bash-log.zsh ] && source ~/.claude/bash-log.zsh'
else
    # ~/.bashrc is interactive-only; CC runs non-interactive bash.
    # BASH_ENV is sourced by bash for every non-interactive shell — the right hook.
    # Prefer ~/.bash_profile (login shell sets env for all children); fall back to ~/.profile.
    if [ -f "$HOME/.bash_profile" ] || [ ! -f "$HOME/.profile" ]; then
        RC_FILE="$HOME/.bash_profile"
    else
        RC_FILE="$HOME/.profile"
    fi
    SOURCE_LINE='export BASH_ENV=~/.claude/bash-log.sh'
fi

# ── Transactional snapshot / rollback (PB-INSTALL-ROLLBACK) ─────────────────
# Before the first mutation, snapshot every file init may modify and record
# which dirs it may create, so ANY non-zero exit — a `set -e` abort, the soft
# FAILED summary, or a trapped interrupt (Ctrl-C / SIGTERM) — restores the
# pre-init state with no content loss and no half-provisioned "mixed" install.
# The heavy lifting is a Python helper (init_txn.py); the shell keeps only a
# tiny EXIT trap. Set PB_INIT_NO_TXN=1 to disable (the rollback test's negative
# control uses this to prove the guarantee is what does the restoring).
TXN_MANIFEST=""
TXN_PROJECT_BACKUP=""
TXN_USER_BACKUP=""
if [ -z "${PB_INIT_NO_TXN:-}" ]; then
    TXN_STAMP="$(date -u +%Y%m%dT%H%M%SZ 2>/dev/null).$$"
    # Every file init may create OR modify (project realm + user realm).
    TXN_FILES="$PROJECT_DIR/CLAUDE.md
$PROJECT_DIR/.gitignore
$PROJECT_DIR/MIND_MAP.md
$PROJECT_DIR/.agent/config.json
$AGENT_DIR/playbooks/README.md
$PROJECT_DIR/.claude/settings.json
$PROJECT_DIR/.claude/bin/tasks
$PROJECT_DIR/.claude/bin/sandbox
$PROJECT_DIR/.claude/bin/monitor
$PROJECT_DIR/.claude/bin/playbook-codex
$PROJECT_DIR/.claude/bin/playbook-agy
$PROJECT_DIR/.claude/bin/playbook-grok
$PROJECT_DIR/.claude/bin/playbook-pi
$PROJECT_DIR/.claude/hooks/monitor-nudge.sh
$AGENT_DIR/monitor/CLAUDE.md
$AGENT_DIR/monitor/MONITOR_MIND_MAP.md
$AGENT_DIR/monitor/rules.md
$HOME/.claude/bash-log.sh
$HOME/.claude/bash-log.zsh
$HOME/.claude/settings.json
$RC_FILE"
    # Every directory init may create; the helper removes only the ones that did
    # NOT pre-exist and are empty after file cleanup (deepest first). A freshly
    # created .agent/ is kept because it then holds the backup.
    TXN_DIRS="$AGENT_DIR/tasks
$AGENT_DIR/playbooks
$AGENT_DIR/monitor
$PROJECT_DIR/.claude/bin
$PROJECT_DIR/.claude/hooks
$PROJECT_DIR/.claude
$AGENT_DIR
$PROJECT_DIR/.agent
$HOME/.claude"
    if ! TXN_OUT=$(PB_TXN_PROJECT_ROOT="$PROJECT_DIR" PB_TXN_HOME="$HOME" \
        PB_TXN_STAMP="$TXN_STAMP" PB_TXN_FILES="$TXN_FILES" PB_TXN_DIRS="$TXN_DIRS" \
        python3 "$SCRIPT_DIR/init_txn.py" begin 2>&1); then
        echo "init: could not take the pre-init snapshot — aborting before any change." >&2
        printf '%s\n' "$TXN_OUT" >&2
        exit 1
    fi
    while IFS= read -r line; do
        line=${line%$'\r'}
        case "$line" in
            MANIFEST:*)       TXN_MANIFEST="${line#MANIFEST:}" ;;
            PROJECT_BACKUP:*) TXN_PROJECT_BACKUP="${line#PROJECT_BACKUP:}" ;;
            USER_BACKUP:*)    TXN_USER_BACKUP="${line#USER_BACKUP:}" ;;
        esac
    done <<< "$TXN_OUT"
fi

# One EXIT trap, delegating to the helper — no per-stage bash bookkeeping. On a
# clean (rc 0) exit the snapshot is kept as the undo point; on any failure it is
# replayed to restore the pre-init state, then the original exit code stands.
_pb_rollback_finalize() {
    local rc=$?
    trap - EXIT
    [ -n "$TXN_MANIFEST" ] || exit "$rc"
    [ "$rc" -eq 0 ] && exit 0
    echo "" >&2
    echo "playbook init FAILED (exit $rc) — restoring the pre-init state." >&2
    if ! python3 "$SCRIPT_DIR/init_txn.py" restore --manifest "$TXN_MANIFEST" >&2; then
        echo "init: rollback hit errors — inspect the preserved backup:" >&2
        echo "  project: $TXN_PROJECT_BACKUP" >&2
        echo "  user:    $TXN_USER_BACKUP" >&2
    fi
    exit "$rc"
}
if [ -n "$TXN_MANIFEST" ]; then
    trap '_pb_rollback_finalize' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
fi

CREATED=()
SKIPPED=()
FAILED=()

# --- (a) <agent-dir>/tasks/ ---
if [ ! -d "$AGENT_DIR/tasks" ]; then
    mkdir -p "$AGENT_DIR/tasks"
    CREATED+=("$AGENT_REL/tasks/")
else
    SKIPPED+=("$AGENT_REL/tasks/ (exists)")
fi

# --- (a2) <agent-dir>/playbooks/ + README ---
# Lane-scoped: tasks/core.py reads playbooks via resolve_agent_dir().
PLAYBOOKS_DIR="$AGENT_DIR/playbooks"
if [ ! -d "$PLAYBOOKS_DIR" ]; then
    mkdir -p "$PLAYBOOKS_DIR"
    # Copy README from the SAME plugin copy this script runs from (a global
    # find could mix versions); deterministic sorted find only as fallback.
    if [ -f "$SCRIPT_DIR/playbooks-README.md" ]; then
        cp "$SCRIPT_DIR/playbooks-README.md" "$PLAYBOOKS_DIR/README.md"
    else
        PLUGIN_README=$(find ~/.claude/plugins -path '*/playbook/scripts/playbooks-README.md' 2>/dev/null | sort | head -1)
        if [ -n "$PLUGIN_README" ]; then
            cp "$PLUGIN_README" "$PLAYBOOKS_DIR/README.md"
        fi
    fi
    CREATED+=("$AGENT_REL/playbooks/")
else
    SKIPPED+=("$AGENT_REL/playbooks/ (exists)")
fi

# --- (a3) .agent/config.json — review knobs + project policy ---
# ROOT, never a lane: config.json is shared repo policy (merge_verify must be
# identical for every clone) and models.json is per-clone judge pins. Both are
# read at the .agent/ root by design — see tasks/core.py.
# Hand-editable. Precedence for each setting: CLI flag > env var > this file >
# built-in default. Only written when absent — never clobbers a user-tuned file.
# (Values here are spelled out so the knobs are discoverable.) `merge_verify` is
# deliberately NOT scaffolded: its absence is meaningful (no post-merge soundness
# command declared), and writing a guessed command would be worse than none.
#
# The timeout pair is scaffolded together on purpose. The built-in defaults are
# soft 900 / hard 300, and since soft is clamped down to a finite hard, taking
# them as-is would give soft == hard == 300 — a wind-down deadline with no room
# to wind down in, and a clamp warning on every review. Scaffolding hard 1200
# makes the intended shape real: wind down at 15 min, hard kill at 20 min, so a
# review always terminates within 20 minutes and always produces something (a
# hard kill now salvages the partial answer to judge-*.partial.log rather than
# discarding it).
CONFIG_JSON="$PROJECT_DIR/.agent/config.json"
if [ ! -f "$CONFIG_JSON" ]; then
    mkdir -p "$PROJECT_DIR/.agent"
    cat > "$CONFIG_JSON" <<'CONFIG'
{
  "_doc": "Playbook settings. Precedence: CLI flag > env var > this file > default. REVIEW KNOBS (naturally per-install; committing them just sets a default others can override via env): judge_budget_usd caps the claude judge's --max-budget-usd (claude backend only; codex/agy/grok/pi have no budget knob); review_soft_timeout_secs is the SOFT deadline the judge is told to wind down against (finish the current thought, then write findings); review_timeout_secs is the HARD wall-clock kill, hang safety only — keep it above soft so there is room to wind down (900 + 300 grace = 1200 here). Either timeout accepts 0 or \"unlimited\" to disable it; a hard kill salvages the judge's partial output to judge-*.partial.log instead of discarding it. NOTE review_timeout_secs is also a FLOOR: once set here, --timeout and the env var may only RAISE it, never undercut it, so an agent cannot reintroduce a kill window you removed. Env overrides: PLAYBOOK_JUDGE_BUDGET_USD, PLAYBOOK_REVIEW_TIMEOUT_SECS, PLAYBOOK_REVIEW_SOFT_TIMEOUT_SECS. PROJECT POLICY — commit this file if you set it: merge_verify {command} is the post-merge soundness command the merge skill runs before it will auto-push, e.g. {\"merge_verify\": {\"command\": \"make test\"}}. Every clone must see the same declaration, so an untracked config leaves that check permanently skipped. Absent or empty means the merge reports SKIPPED and hands the push back to you; a malformed declaration BLOCKS the merge's verify step rather than being ignored. panel_required_for controls which closes require a quorum-PASS panel impl review in judge.md: the seeded default [\"assertive\",\"irreversible\"] requires it only for changes to claims-about-the-world (assertive) and data/publish/irreversible work — reversible work (the common case, incl. quick/light) closes on verify+single-judge evidence with no panel wait; set \"all\" to require a panel on EVERY close (max strictness); omit or set [] to disable the panel bar. See docs/configuration.md.",
  "judge_budget_usd": 10,
  "review_soft_timeout_secs": 900,
  "review_timeout_secs": 1200,
  "panel_required_for": ["assertive", "irreversible"]
}
CONFIG
    CREATED+=(".agent/config.json")
else
    SKIPPED+=(".agent/config.json (exists)")
fi

# --- (a4) .agent/models.json — judge pins pointer (task 012) ---
# NOT auto-created: judge selection is the user's call, and pins are
# machine-specific (the file is gitignored). Point at the maintenance loop.
if [ ! -f "$PROJECT_DIR/.agent/models.json" ]; then
    echo "note: no .agent/models.json — judge panel uses the plugin's shipped defaults."
    echo "      Pin per-machine judges with: tasks models check   (live availability audit)"
    echo "                                   tasks models select  (writes .agent/models.json)"
fi

# On Git-Bash/MSYS, python3 is usually native Windows Python, which cannot open
# MSYS-style paths (/c/Users/...). Convert to a mixed-mode Windows path
# (C:/Users/...) — forward slashes so it's also safe inside a Python string
# literal — before handing a path to python3. No-op on real POSIX, where
# cygpath is absent and the original path is echoed unchanged.
to_native_path() {
    cygpath -m "$1" 2>/dev/null || echo "$1"
}

# --- (b) settings.json permissions.deny merge ---
SETTINGS_FILE="$PROJECT_DIR/.claude/settings.json"
mkdir -p "$PROJECT_DIR/.claude"
SETTINGS_FILE_PY="$(to_native_path "$SETTINGS_FILE")"

SETTINGS_RESULT=$(PB_SETTINGS_PATH="$SETTINGS_FILE_PY" python3 -c "
import json, sys, os

# I4: read the path from the environment, never interpolate it into the source
# — a project path with a single quote otherwise breaks python's string literal
# (SyntaxError → set -e abort).
path = os.environ['PB_SETTINGS_PATH']
required = ['TodoWrite', 'Task', 'EnterPlanMode']

try:
    if os.path.exists(path):
        with open(path) as f:
            data = json.load(f)
        if not isinstance(data, dict):
            print('ERROR:settings.json root is not an object', file=sys.stderr)
            sys.exit(1)
    else:
        data = {}

    perms = data.setdefault('permissions', {})
    deny = perms.setdefault('deny', [])
    added = []
    for item in required:
        if item not in deny:
            deny.append(item)
            added.append(item)

    if added:
        with open(path, 'w') as f:
            json.dump(data, f, indent=2)
            f.write('\n')
        print('CREATED:' + ','.join(added))
    else:
        print('SKIPPED')
except json.JSONDecodeError as e:
    print(f'ERROR:settings.json is malformed JSON: {e}', file=sys.stderr)
    sys.exit(1)
" 2>&1) || {
    FAILED+=("settings.json ($SETTINGS_RESULT)")
    SETTINGS_RESULT=""
}

if [ -n "$SETTINGS_RESULT" ]; then
    case "$SETTINGS_RESULT" in
        CREATED:*)
            CREATED+=("settings.json deny: ${SETTINGS_RESULT#CREATED:}")
            ;;
        SKIPPED)
            SKIPPED+=("settings.json (already has deny list)")
            ;;
        ERROR:*)
            FAILED+=("settings.json: ${SETTINGS_RESULT#ERROR:}")
            ;;
    esac
fi

# --- (c) MIND_MAP.md stub ---
if [ ! -f "$PROJECT_DIR/MIND_MAP.md" ]; then
    echo "# Mind Map — $PROJECT_NAME" > "$PROJECT_DIR/MIND_MAP.md"
    CREATED+=("MIND_MAP.md (stub — run /mindmap to populate)")
else
    SKIPPED+=("MIND_MAP.md (exists)")
fi

# --- (d) .claude/bin/ wrappers ---
create_wrapper "$PROJECT_DIR" tasks
if [ -f "$PROJECT_DIR/.claude/bin/tasks" ]; then
    CREATED+=(".claude/bin/tasks")
fi

create_wrapper "$PROJECT_DIR" sandbox
if [ -f "$PROJECT_DIR/.claude/bin/sandbox" ]; then
    CREATED+=(".claude/bin/sandbox")
fi

# Provider launchers: thin find-and-exec wrappers so each provider's gate-hooked
# entry point is reachable as .claude/bin/playbook-<x> in any project (the plugin
# scripts/ dir is not on PATH). Generated uniformly; running one whose CLI isn't
# installed just errors at exec time.
for provider_wrapper in playbook-codex playbook-agy playbook-grok playbook-pi; do
    create_wrapper "$PROJECT_DIR" "$provider_wrapper"
    if [ -f "$PROJECT_DIR/.claude/bin/$provider_wrapper" ]; then
        CREATED+=(".claude/bin/$provider_wrapper")
    fi
done

# --- (e) bash history logging ---
# BEGIN:bash-log
#
# `bash-log.sh` is deployed on EVERY host, regardless of login shell, because
# Claude Code's Bash tool is /bin/bash no matter what $SHELL says — and the
# settings.json injection below always points BASH_ENV at it. Before task 027
# the $SHELL branch deployed ONLY bash-log.zsh on zsh hosts while still setting
# BASH_ENV=~/.claude/bash-log.sh, so on every macOS/zsh install that variable
# dangled at a nonexistent file and CC-side command logging was silently dead.
# (Task 023 found this but deferred it deliberately: fixing it ARMS bash-log's
# DEBUG trap on every zsh host, which was unsafe until the trap's set -e kill
# path was fixed. That shipped in v1.4.6, so it is safe now — this change must
# never be cherry-picked back before it.)
#
# The $SHELL branch now decides only the EXTRA host-shell integration: an
# interactive zsh needs bash-log.zsh + a .zshenv source line, since zsh ignores
# BASH_ENV.
deploy_bash_log() {   # $1 = filename under $SCRIPT_DIR; deploys to ~/.claude/
    local file="$1" src="$SCRIPT_DIR/$1" dest="$HOME/.claude/$1" tmp
    [ -f "$src" ] || return 0
    mkdir -p "$HOME/.claude"
    # Normalize CRLF→LF on the way out. These files are SOURCED by every hook
    # shell, and a CRLF copy from a Windows checkout breaks that; normalizing at
    # deploy time also makes the up-to-date comparison meaningful, since
    # comparing a CRLF source against an LF destination never matches and would
    # re-copy on every single init run. Written through a temp + atomic mv, the
    # same shape the rest of init uses (and no process substitution, which needs
    # /dev/fd and is shakier inside the sandboxes we run under).
    tmp="$dest.tmp.$$"
    tr -d '\r' < "$src" > "$tmp" || { rm -f "$tmp"; FAILED+=("~/.claude/$file (normalize failed)"); return 0; }
    if [ ! -f "$dest" ]; then
        mv "$tmp" "$dest"
        CREATED+=("~/.claude/$file")
    elif cmp -s "$tmp" "$dest"; then
        rm -f "$tmp"
        SKIPPED+=("~/.claude/$file (unchanged)")
    else
        mv "$tmp" "$dest"
        CREATED+=("~/.claude/$file (updated)")
    fi
}

# SHELL_NAME, RC_FILE, and SOURCE_LINE were resolved up front (before the
# snapshot), since the rc file is one of the snapshotted paths.
# The bash variant is what BASH_ENV names, so it is unconditional.
BASH_LOG_SRC="$SCRIPT_DIR/bash-log.sh"

if [ -f "$BASH_LOG_SRC" ]; then
    deploy_bash_log "bash-log.sh"
    # zsh hosts additionally get the zsh variant for their interactive shells.
    if [ "$SHELL_NAME" = "zsh" ]; then
        deploy_bash_log "bash-log.zsh"
    fi

    if grep -qF 'claude/bash-log' "$RC_FILE" 2>/dev/null; then
        SKIPPED+=("$RC_FILE (source line exists)")
    else
        { echo ""; echo "# claude-playbook: command logging"; echo "$SOURCE_LINE"; } >> "$RC_FILE"
        CREATED+=("$RC_FILE (source line added)")
    fi

    # Inject BASH_ENV into ~/.claude/settings.json so CC passes it to every bash shell it spawns.
    # This is the reliable path — CC reads settings.json env key and injects vars before tool calls.
    CC_SETTINGS="$HOME/.claude/settings.json"
    CC_SETTINGS_PY="$(to_native_path "$CC_SETTINGS")"
    BASH_ENV_RESULT=$(PB_CC_SETTINGS_PATH="$CC_SETTINGS_PY" python3 -c "
import json, os, tempfile
# I4: path via env, not interpolated (single-quote paths would SyntaxError).
path = os.environ['PB_CC_SETTINGS_PATH']
# Always bash-log.sh — CC's Bash tool is /bin/bash regardless of user's login shell.
# Point BASH_ENV at the SAME dir deploy_bash_log wrote to, which uses the shell's
# $HOME. On Windows os.path.expanduser('~') prefers USERPROFILE over $HOME, so it
# could name a DIFFERENT dir than where the file was deployed and leave BASH_ENV
# dangling — the exact dangling-reference bug this path exists to prevent. Derive
# from $HOME (always set under the bash that runs init); fall back to expanduser
# only if it is somehow unset. Forward-slash the result: BASH_ENV is read by
# Git-Bash, which needs a POSIX-sourceable path (C:/Users/... works). No-op on
# POSIX, where $HOME == expanduser('~').
home = os.environ.get('HOME') or os.path.expanduser('~')
dest = os.path.join(home, '.claude', 'bash-log.sh').replace(os.sep, '/')
try:
    data = json.loads(open(path).read()) if os.path.exists(path) else {}
    env = data.setdefault('env', {})
    if env.get('BASH_ENV') == dest:
        print('SKIPPED')
    else:
        env['BASH_ENV'] = dest
        tmp = path + '.tmp'
        open(tmp, 'w').write(json.dumps(data, indent=2) + '\n')
        os.replace(tmp, path)
        print('CREATED')
except Exception as e:
    print('ERROR:' + str(e))
" 2>&1)
    case "$BASH_ENV_RESULT" in
        CREATED)  CREATED+=("~/.claude/settings.json (BASH_ENV set)") ;;
        SKIPPED)  SKIPPED+=("~/.claude/settings.json (BASH_ENV already set)") ;;
        ERROR:*)  FAILED+=("~/.claude/settings.json: ${BASH_ENV_RESULT#ERROR:}") ;;
    esac
else
    SKIPPED+=("bash-log (not bundled in plugin scripts — skipping)")
fi
# END:bash-log

# --- (g) Monitor scaffolding ---
# Scaffolds <agent-dir>/monitor/ (per-user state dir) + .claude/hooks/monitor-nudge.sh
# (non-plugin hook for nudge injection) + .claude/bin/monitor wrapper + registers
# PostToolUse hook in .claude/settings.json. Idempotent.

MONITOR_LIB_DIR=""
MONITOR_HOOK_SRC=""
# SCRIPT_DIR may be the plugin cache dir (normal) or the dev repo's scripts/ dir.
# Look for monitor-lib alongside this script first; fall back to plugin cache.
if [ -d "$SCRIPT_DIR/monitor-lib" ]; then
    MONITOR_LIB_DIR="$SCRIPT_DIR/monitor-lib"
else
    MONITOR_LIB_DIR=$(find ~/.claude/plugins -path '*/playbook/scripts/monitor-lib' -type d 2>/dev/null | sort | head -1)
fi
# monitor-nudge.sh ships in hooks/ (parent of scripts/).
if [ -f "$SCRIPT_DIR/../hooks/monitor-nudge.sh" ]; then
    MONITOR_HOOK_SRC="$SCRIPT_DIR/../hooks/monitor-nudge.sh"
else
    MONITOR_HOOK_SRC=$(find ~/.claude/plugins -path '*/playbook/hooks/monitor-nudge.sh' -type f 2>/dev/null | sort | head -1)
fi

if [ -n "$MONITOR_LIB_DIR" ] && [ -d "$MONITOR_LIB_DIR" ]; then
    MON_DIR="$AGENT_DIR/monitor"
    MON_STATE_CREATED=0
    mkdir -p "$MON_DIR"

    # Copy CLAUDE.md (template — always re-copy so updates propagate)
    cp "$MONITOR_LIB_DIR/CLAUDE.md" "$MON_DIR/CLAUDE.md"

    # T121 flat layout: remove stale sandbox.sb (inline PROFILE in launch-monitor
    # is the source of truth) and stale pids/ subdir (single session.md now)
    rm -f "$MON_DIR/sandbox.sb"

    # Copy SSP + mind map stubs ONLY if target doesn't already have them
    # (stubs carry seed scaffolding — actions/dimensions/features/rules skeleton +
    # orientation nodes; monitor edits in place as patterns crystallize)
    for stub in MONITOR_MIND_MAP.md rules.md; do
        if [ ! -f "$MON_DIR/$stub" ]; then
            cp "$MONITOR_LIB_DIR/stubs/$stub" "$MON_DIR/$stub"
            MON_STATE_CREATED=1
        fi
    done

    if [ "$MON_STATE_CREATED" = "1" ]; then
        CREATED+=("$AGENT_REL/monitor/ (scaffolded)")
    else
        SKIPPED+=("$AGENT_REL/monitor/ (state files exist)")
    fi

    # Copy monitor-nudge.sh into target's .claude/hooks/
    if [ -n "$MONITOR_HOOK_SRC" ] && [ -f "$MONITOR_HOOK_SRC" ]; then
        mkdir -p "$PROJECT_DIR/.claude/hooks"
        cp "$MONITOR_HOOK_SRC" "$PROJECT_DIR/.claude/hooks/monitor-nudge.sh"
        chmod +x "$PROJECT_DIR/.claude/hooks/monitor-nudge.sh"
        CREATED+=(".claude/hooks/monitor-nudge.sh")
    else
        FAILED+=("monitor-nudge.sh source not found")
    fi

    # Create .claude/bin/monitor wrapper (same pattern as sandbox, tasks)
    create_wrapper "$PROJECT_DIR" monitor
    if [ -f "$PROJECT_DIR/.claude/bin/monitor" ]; then
        CREATED+=(".claude/bin/monitor")
    fi

    # Register PostToolUse hook for monitor-nudge in .claude/settings.json
    NUDGE_HOOK_CMD='bash "$CLAUDE_PROJECT_DIR/.claude/hooks/monitor-nudge.sh"'
    HOOK_RESULT=$(PB_SETTINGS_PATH="$SETTINGS_FILE_PY" PB_NUDGE_CMD="$NUDGE_HOOK_CMD" python3 -c "
import json, os
# I4: path AND command via env, never interpolated — a single quote in either
# broke the python literal (SyntaxError → set -e abort mid-install).
path = os.environ['PB_SETTINGS_PATH']
target_cmd = os.environ['PB_NUDGE_CMD']
try:
    data = json.loads(open(path).read()) if os.path.exists(path) else {}
    hooks = data.setdefault('hooks', {})
    posthook = hooks.setdefault('PostToolUse', [])
    already = any(
        any(h.get('command') == target_cmd for h in (b.get('hooks') or []))
        for b in posthook if isinstance(b, dict)
    )
    if already:
        print('SKIPPED')
    else:
        posthook.append({'matcher': '', 'hooks': [{'type': 'command', 'command': target_cmd}]})
        open(path, 'w').write(json.dumps(data, indent=2) + '\n')
        print('CREATED')
except Exception as e:
    print('ERROR:' + str(e))
" 2>&1)
    case "$HOOK_RESULT" in
        CREATED)  CREATED+=("settings.json PostToolUse monitor-nudge hook") ;;
        SKIPPED)  SKIPPED+=("settings.json PostToolUse monitor-nudge (already registered)") ;;
        ERROR:*)  FAILED+=("settings.json monitor hook: ${HOOK_RESULT#ERROR:}") ;;
    esac
else
    SKIPPED+=("$AGENT_REL/monitor/ (monitor-lib not found in plugin)")
fi

# --- (h) CLAUDE.md + .gitignore — mechanical doctrine files (F15) ---
# These were the AGENT half of /playbook:init: the doctrine (CLAUDE.md teaches
# the correctness contract; .gitignore keeps runtime state out of the record)
# held only if the agent performed it. Written mechanically now — MERGING,
# never clobbering: a seeded CLAUDE.md keeps its content, template-owned
# sections update in place, custom sections survive byte-for-byte, and the
# .gitignore block is marker-guarded so re-runs are no-ops. The agent half
# shrinks to project-specific enrichment.
# I4: guard the assignment — `set -e` aborts on a bare `VAR=$(cmd)` when cmd
# fails, which would kill init here (before the FAILED handler + summary) on any
# CLAUDE.md merge failure. The `if` form captures output AND rc without aborting.
if MERGE_OUT=$(python3 "$(to_native_path "$SCRIPT_DIR/claude-md-merge.py")" \
    "$(to_native_path "$SCRIPT_DIR/CLAUDE.md.template")" \
    "$(to_native_path "$PROJECT_DIR")" "$PROJECT_NAME" 2>&1); then
    MERGE_RC=0
else
    MERGE_RC=$?
fi
while IFS= read -r line; do
    # claude-md-merge.py prints via Python text-mode stdout, which on Windows
    # emits CRLF; command substitution keeps the embedded CR, so `$line` arrives
    # as `CLAUDE.md:CREATED\r` and matches NONE of the exact patterns below,
    # dropping every status into the catch-all → a spurious FAILED → exit 1 even
    # though init did all its work. Strip a trailing CR. No-op on Linux/macOS.
    line=${line%$'\r'}
    case "$line" in
        CLAUDE.md:CREATED)    CREATED+=("CLAUDE.md (from template)") ;;
        CLAUDE.md:MERGED)     CREATED+=("CLAUDE.md (template sections merged — project content preserved)") ;;
        CLAUDE.md:UNCHANGED)  SKIPPED+=("CLAUDE.md (already current)") ;;
        .gitignore:CREATED)   CREATED+=(".gitignore (playbook runtime-state block)") ;;
        .gitignore:APPENDED)  CREATED+=(".gitignore playbook runtime-state block (appended)") ;;
        .gitignore:UNCHANGED) SKIPPED+=(".gitignore (playbook block present)") ;;
        ERROR:*)              FAILED+=("CLAUDE.md/.gitignore: ${line#ERROR:}") ;;
        "") ;;
        *)                    FAILED+=("CLAUDE.md/.gitignore: unexpected output: $line") ;;
    esac
done <<< "$MERGE_OUT"
if [ $MERGE_RC -ne 0 ] && [ ${#FAILED[@]} -eq 0 ]; then
    FAILED+=("CLAUDE.md/.gitignore: claude-md-merge.py exited $MERGE_RC")
fi

# --- (f) Summary ---
echo "playbook init: $PROJECT_NAME"
echo ""
if [ ${#CREATED[@]} -gt 0 ]; then
    echo "Created:"
    for item in "${CREATED[@]}"; do
        echo "  + $item"
    done
fi
if [ ${#SKIPPED[@]} -gt 0 ]; then
    echo "Skipped:"
    for item in "${SKIPPED[@]}"; do
        echo "  - $item"
    done
fi
if [ ${#FAILED[@]} -gt 0 ]; then
    echo "FAILED:"
    for item in "${FAILED[@]}"; do
        echo "  ! $item"
    done
    # A non-zero exit trips the EXIT trap, which rolls back to the pre-init
    # state — no partial or mixed-version install is left behind.
    exit 1
fi

# Clean run: keep the snapshot as the documented undo path and point at it.
if [ -n "$TXN_PROJECT_BACKUP" ]; then
    echo ""
    echo "Undo: this run's pre-init snapshot is kept at"
    echo "  $TXN_PROJECT_BACKUP  (project files)"
    echo "  $TXN_USER_BACKUP  (user files)"
    echo "Restore it by hand, or delete it once you're happy with the setup."
fi
