#!/usr/bin/env python3
"""Canonical verification entrypoint: run every check, print PASS/FAIL/SKIP.

Stdlib-only, Python 3 — must behave identically on Linux, macOS and
Windows/Git Bash. Shell fixtures are invoked as `bash` subprocesses.
Exit code is non-zero iff at least one check FAILed; SKIP never fails the run.

The bash used for the shell-dependent checks is resolved once at startup: set
$PLAYBOOK_VERIFY_BASH to an absolute path to override (CI exports it from inside
its Git Bash step so Python does not pick up the Windows System32 WSL stub);
otherwise `bash` on PATH is used. If the resolved bash is unusable (the WSL stub
prints an install hint and exits non-zero), the shell checks SKIP — a missing
usable bash is an environment fact, not a product defect.
"""

from __future__ import annotations

import argparse
import ast
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
PY_FLOOR = (3, 10)          # declared floor: docs/guarantee-ledger.md
PASS, FAIL, SKIP = "PASS", "FAIL", "SKIP"
BASH_OVERRIDE_ENV = "PLAYBOOK_VERIFY_BASH"   # override: absolute path to the bash to use

# Resolved once in main(): the bash all shell checks use, whether it works, and
# how it was resolved / why it is unusable.
BASH_PATH: str | None = None
BASH_USABLE = False
BASH_NOTE = ""

results: list[dict] = []
CHECKS: list[tuple] = []


def env() -> dict:
    """Child env with dogfooding state stripped (see tests/test_shell_fixtures.py)."""
    e = dict(os.environ)
    for k in ("BASH_ENV", "PLAYBOOK_SESSION_ID", "PLAYBOOK_ROLE", "PLAYBOOK_EVAL_CONFIG"):
        e.pop(k, None)
    return e


def decode(raw: bytes) -> str:
    """Decode captured subprocess bytes defensively across platforms.

    We capture bytes (not text=True): on Windows/Git Bash a child can emit
    UTF-16, or interleave NUL bytes, which the old text-mode capture reduced to
    a lone `^@` (NUL) — an unreadable detail line that looked like N broken
    files when it was one decoding defect. Recover the text when we can;
    otherwise say so explicitly with the raw length and leading bytes in hex,
    and never return a NUL-only string.
    """
    if not raw:
        return ""
    if raw[:2] in (b"\xff\xfe", b"\xfe\xff"):            # UTF-16 with BOM
        try:
            return raw.decode("utf-16").replace("\x00", "")
        except (UnicodeDecodeError, ValueError):
            pass
    if raw.count(0) * 4 > len(raw):                       # NUL-heavy → likely UTF-16
        for enc in ("utf-16-le", "utf-16-be"):
            try:
                text = raw.decode(enc)
                if "\x00" not in text:
                    return text
            except (UnicodeDecodeError, ValueError):
                pass
    text = raw.decode("utf-8", "replace").replace("\x00", "")
    if text.strip():
        return text
    return f"<undecodable output: {len(raw)} bytes, first bytes: {raw[:32].hex(' ')}>"


def run(cmd: list[str], cwd: Path | str = ROOT, timeout: int = 900):
    p = subprocess.run(cmd, cwd=str(cwd), env=env(), timeout=timeout,
                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    return p.returncode, decode(p.stdout)


def resolve_bash() -> tuple[str | None, str]:
    """Pick the bash the shell checks will use, honouring $PLAYBOOK_VERIFY_BASH
    (CI sets it so Python doesn't resolve the Windows System32 WSL stub), else
    `bash` on PATH. Returns (path_or_None, how_it_was_resolved)."""
    override = os.environ.get(BASH_OVERRIDE_ENV)
    if override:
        # A cygpath -w conversion drops the .exe; recover it so CreateProcess
        # execs the real binary rather than falling through to a SKIP.
        if not Path(override).exists() and Path(override + ".exe").exists():
            override += ".exe"
        return override, f"${BASH_OVERRIDE_ENV}"
    found = shutil.which("bash")
    return found, ("PATH" if found else "PATH (not found)")


def bash_usable(path: str) -> tuple[bool, str]:
    """True iff `path` runs a trivial command. The Windows System32 bash.exe is
    the WSL launcher: with no distro it prints an install hint and exits
    non-zero, so a presence check is not enough — probe for a sentinel back."""
    try:
        p = subprocess.run([path, "-c", "printf ok"], env=env(), timeout=30,
                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    except (OSError, subprocess.SubprocessError) as exc:
        return False, f"{type(exc).__name__}: {exc}"
    out = decode(p.stdout)
    if p.returncode == 0 and out.strip() == "ok":
        return True, ""
    return False, f"rc={p.returncode}: {tail(out, 1)}"


def tail(text: str, n: int = 2) -> str:
    lines = [ln.strip() for ln in text.strip().splitlines() if ln.strip()]
    return " / ".join(lines[-n:])[:220] if lines else "(no output)"


def ut_tail(text: str) -> str:
    """Prefer unittest's own verdict line over whatever a test printed last."""
    lines = [ln.strip() for ln in text.strip().splitlines() if ln.strip()]
    for ln in reversed(lines):
        if ln == "OK" or ln.startswith(("OK ", "FAILED", "Ran ", "No tests")):
            i = lines.index(ln)
            return " / ".join(lines[max(0, i - 1):i + 1])[:220]
    return tail(text)


def cap(items: list[str], n: int = 20) -> list[str]:
    """First n detail lines, then a count of the remainder."""
    return items if len(items) <= n else items[:n] + [f"... and {len(items) - n} more"]


def ut_fails(text: str, per_cap: int = 15, overall_cap: int = 80) -> list[str]:
    """Each unittest FAIL/ERROR as its identifier PLUS the message body that
    follows it — the lines from the FAIL:/ERROR: header through the end of that
    failure block (traceback + assertion message). Capped per failure and
    overall, with a `... and N more` marker, so a multi-line assertion message
    (e.g. a dumped seatbelt profile) reaches the log without flooding it."""
    def rule(s: str, ch: str) -> bool:                 # unittest frames blocks with ==== / ----
        s = s.strip()
        return len(s) >= 20 and set(s) == {ch}

    raw = text.splitlines()
    out: list[str] = []
    i, n = 0, len(raw)
    while i < n:
        if not raw[i].startswith(("FAIL:", "ERROR:")):
            i += 1
            continue
        block = [raw[i].strip()]
        i += 1
        if i < n and rule(raw[i], "-"):                # frame rule directly under the header
            i += 1
        while i < n and not rule(raw[i], "="):         # next block boundary
            if rule(raw[i], "-") and i + 1 < n and raw[i + 1].strip().startswith("Ran "):
                break                                  # final boundary before the summary
            block.append(raw[i].rstrip())
            i += 1
        while block and not block[-1].strip():         # trim trailing blanks
            block.pop()
        if len(block) > per_cap:
            block = block[:per_cap] + [f"    ... and {len(block) - per_cap} more lines"]
        out.extend(block)
    return cap(out, overall_cap)


def sh_fails(text: str) -> list[str]:
    """Failing assertion lines from a shell fixture (it prints `  FAIL  ...`)."""
    return cap([ln.strip() for ln in text.splitlines() if ln.strip().startswith("FAIL")])


def record(name, status, detail="", started=None, lines=None):
    results.append({"check": name, "status": status, "detail": detail,
                    "detail_lines": lines or [],
                    "seconds": round(time.time() - started, 1) if started else 0.0})


def check(name, needs: dict[str, str] | None = None):
    """Decorator: register a check in declaration order; main() runs them."""
    def deco(fn):
        CHECKS.append((name, needs or {}, fn))
        return fn
    return deco


def run_checks() -> None:
    for name, needs, fn in CHECKS:
        skip = None
        for tool, why in needs.items():
            if tool == "bash":                       # resolved+probed, not just present
                if not BASH_USABLE:
                    skip = (f"resolved bash unusable ({BASH_PATH}) — {BASH_NOTE}"
                            if BASH_PATH else f"no bash resolved — {BASH_NOTE}")
                    break
            elif shutil.which(tool) is None:
                skip = f"{tool} not found on PATH — {why}"
                break
        if skip:
            record(name, SKIP, skip)
            continue
        t0 = time.time()
        lines: list[str] = []
        try:
            res = fn()
            status, detail = res[0], res[1]
            lines = res[2] if len(res) > 2 else []
        except subprocess.TimeoutExpired:
            status, detail = FAIL, "timed out"
        except Exception as exc:                        # a broken check is a FAIL
            status, detail = FAIL, f"{type(exc).__name__}: {exc}"
        record(name, status, detail, t0, lines)


def tracked(*suffixes: str) -> list[str]:
    # NUL-separated by design — capture bytes and split before decoding each
    # name, so decode()'s NUL-stripping never eats the separators.
    p = subprocess.run(["git", "ls-files", "-z"], cwd=str(ROOT), env=env(),
                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=120)
    if p.returncode != 0:
        raise RuntimeError(f"git ls-files failed: {decode(p.stdout)}")
    files = [f.decode("utf-8", "replace") for f in p.stdout.split(b"\0") if f]
    return [f for f in files if not suffixes or f.endswith(suffixes)]


def no_dup_pairs(pairs):
    seen = set()
    for k, _ in pairs:
        if k in seen:
            raise ValueError(f"duplicate member: {k!r}")
        seen.add(k)
    return dict(pairs)


def is_shell(rel: str) -> bool:
    if rel.endswith(".ts"):
        return False
    if rel.endswith((".sh", ".zsh")):
        return True
    p = ROOT / rel
    try:
        first = p.open("rb").readline(200).decode("utf-8", "replace")
    except OSError:
        return False
    return first.startswith("#!") and ("sh" in first.split("/")[-1].split()[0] or " sh" in first)


GIT = {"git": "cannot enumerate tracked files"}
BASH = {"bash": "shell fixtures need bash"}


@check("unittest discover")
def _unittest():
    rc, out = run([sys.executable, "-m", "unittest", "discover", "-s", "tests", "-q"])
    if rc == 0:
        return PASS, ut_tail(out)
    return FAIL, ut_tail(out), ut_fails(out)


@check("wrapper-multiuser fixture", {**BASH, **GIT})
def _wrapper():
    with tempfile.TemporaryDirectory() as td:
        rc, out = run([BASH_PATH, str(ROOT / "tests" / "wrapper-multiuser-fixture.sh")], cwd=td)
    counts = [ln for ln in out.splitlines() if "passed," in ln and "failed" in ln]
    detail = counts[-1].strip() if counts else tail(out)
    if rc == 0:
        return PASS, detail
    return FAIL, detail, sh_fails(out)


@check("merge-verify fixture", {**BASH, **GIT})
def _merge():
    with tempfile.TemporaryDirectory() as td:
        rc, out = run([BASH_PATH, str(ROOT / "tests" / "merge-verify-fixture.sh")], cwd=td)
    counts = [ln for ln in out.splitlines() if "passed," in ln and "failed" in ln]
    detail = counts[-1].strip() if counts else tail(out)
    if rc == 0:
        return PASS, detail
    return FAIL, detail, sh_fails(out)


@check("guarantee ledger")
def _ledger():
    rc1, out1 = run([sys.executable, "scripts/guarantee_ledger.py", "--summary"], timeout=300)
    rc2, out2 = run([sys.executable, "-m", "unittest", "tests.test_guarantee_ledger", "-q"], timeout=300)
    if rc1 == 0 and rc2 == 0:
        return PASS, "--summary ok / unit tests ok"
    detail = f"--summary rc={rc1}: {tail(out1, 1)} | unittest rc={rc2}: {tail(out2, 1)}"
    lines = ut_fails(out2) + ([f"--summary: {ln}" for ln in cap(out1.strip().splitlines())] if rc1 != 0 else [])
    return FAIL, detail, lines


@check("version + mirror parity")
def _parity():
    rc, out = run([sys.executable, "-m", "unittest",
                   "tests.test_version_parity", "tests.test_mirror_sync", "-q"], timeout=600)
    if rc == 0:
        return PASS, ut_tail(out)
    return FAIL, ut_tail(out), ut_fails(out)


@check("json strict parse", GIT)
def _json():
    bad = []
    files = tracked(".json")
    for rel in files:
        try:
            json.loads((ROOT / rel).read_text(encoding="utf-8"), object_pairs_hook=no_dup_pairs)
        except Exception as exc:
            bad.append(f"{rel}: {exc}")
    if not bad:
        return PASS, f"{len(files)} files, no duplicate members"
    return FAIL, f"{len(bad)} invalid of {len(files)}", cap(bad)


@check(f"ast.parse @ py{PY_FLOOR[0]}.{PY_FLOOR[1]}", GIT)
def _ast():
    bad = []
    files = tracked(".py")
    for rel in files:
        try:
            ast.parse((ROOT / rel).read_text(encoding="utf-8"), filename=rel,
                      feature_version=PY_FLOOR)
        except SyntaxError as exc:
            bad.append(f"{rel}:{exc.lineno}: {exc.msg}")
        except Exception as exc:
            bad.append(f"{rel}: {type(exc).__name__}: {exc}")
    if not bad:
        return PASS, f"{len(files)} files"
    return FAIL, f"{len(bad)} invalid of {len(files)}", cap(bad)


@check("bash -n shell files", {**BASH, **GIT})
def _bashn():
    bad = []                                    # one entry per file, so len == distinct files
    files = [f for f in tracked() if is_shell(f)]
    for rel in files:
        rc, out = run([BASH_PATH, "-n", rel], timeout=60)
        if rc != 0:
            bad.append(f"{rel}: {tail(out, 1)}")
    if not bad:
        return PASS, f"{len(files)} files"
    return FAIL, f"{len(bad)} of {len(files)} distinct files failed bash -n", cap(bad)


@check("git diff --check", GIT)
def _diffcheck():
    rc, out = run(["git", "diff", "--check"], timeout=120)
    if rc == 0:
        return PASS, "no whitespace errors"
    return FAIL, tail(out), cap([ln.strip() for ln in out.splitlines() if ln.strip()])


def main() -> int:
    ap = argparse.ArgumentParser(description="Run every check in this repo.")
    ap.add_argument("--json", action="store_true", help="machine-readable summary on stdout")
    args = ap.parse_args()

    global BASH_PATH, BASH_USABLE, BASH_NOTE
    BASH_PATH, how = resolve_bash()
    if BASH_PATH is None:
        BASH_USABLE, BASH_NOTE = False, how
    else:
        BASH_USABLE, why = bash_usable(BASH_PATH)
        BASH_NOTE = how if BASH_USABLE else f"{how}: {why}"
    bash_desc = f"{BASH_PATH or 'not found'}" + ("" if BASH_USABLE else " (unusable)")

    run_checks()
    failed = sum(1 for r in results if r["status"] == FAIL)
    summary = {
        "root": str(ROOT),
        "platform": sys.platform,
        "python": sys.version.split()[0],
        "bash": {"path": BASH_PATH, "usable": BASH_USABLE, "resolved": BASH_NOTE},
        "checks": results,
        "totals": {s: sum(1 for r in results if r["status"] == s) for s in (PASS, FAIL, SKIP)},
        "exit_code": 1 if failed else 0,
    }
    if args.json:
        print(json.dumps(summary, indent=2))
    else:
        w = max(len(r["check"]) for r in results)
        print(f"\n  playbook verify — {sys.platform}, python {summary['python']}, "
              f"bash {bash_desc}\n")
        for r in results:
            print(f"  {r['status']:<5} {r['check']:<{w}}  {r['seconds']:>6.1f}s  {r['detail']}")
            if r["status"] == FAIL:
                for ln in r["detail_lines"]:
                    print(f"        {ln}")
        t = summary["totals"]
        print(f"\n  {t[PASS]} passed, {t[FAIL]} failed, {t[SKIP]} skipped\n")
    return summary["exit_code"]


if __name__ == "__main__":
    sys.exit(main())
