+  try {
+    return await attempt();
+  } catch (err) {
+    if (!isRetriableFetchError(err)) throw err;
+    if (opts.canRetry && !opts.canRetry()) throw err;
+    if (opts.backoffMs > 0) await new Promise((resolve) => setTimeout(resolve, opts.backoffMs));
+    return attempt();
