+# PHOTON_BASE_URL="https://photon.komoot.io"
+# ORS_BASE_URL="https://api.openrouteservice.org"
+# TRANSIT_BASE_URL="https://api.transitous.org"   # feeds both one-to-all + plan
+#
+# Overpass endpoint pools (comma/space-separated; first healthy host wins).
+# Interactive route/stop queries (default = 3 hosts):
+# OVERPASS_ENDPOINTS="https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter"
