+  it("resolves a relative override against cwd", () => {
+    expect(tilesPmtilesPath({ TILES_PMTILES_PATH: "data/tiles/cluj.pmtiles" })).toBe(
+      `${process.cwd()}/data/tiles/cluj.pmtiles`,
