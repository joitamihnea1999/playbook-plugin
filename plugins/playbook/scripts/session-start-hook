#!/bin/bash
# session-start-hook
# SessionStart hook — persists session_id as PLAYBOOK_SESSION_ID env var.
#
# Uses CLAUDE_ENV_FILE to make the env var available in all subsequent
# Bash commands for the session. This enables per-session task state:
# each agent gets its own .agent/sessions/<session_id>/ directory.
#
# Note: CLAUDE_ENV_FILE doesn't work in VSCode extension (as of Feb 2026).
# The PreToolUse hook (task-gate-hook) injects the env var via updatedInput
# as a fallback. This hook is kept for when CLAUDE_ENV_FILE works (CLI).

set -e

# Skip when invoked from the monitor's own claude session (see launch-monitor).
# Log to stderr so the hook's firing is still visible; only gate-enforcement skipped.
if [ "${PLAYBOOK_ROLE:-}" = "monitor" ]; then
    echo "[$(basename "$0")] skip (PLAYBOOK_ROLE=monitor)" >&2
    exit 0
fi

# Source shared lib (same directory)
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$HOOK_DIR/gate-echo-lib.sh"

# Use PID-based session ID via resolve_session_id (gate-echo-lib.sh).
# Walks process tree, finds claude/codex/agy/pi ancestor, uses pid-<that>.
# Same value as pid-$PPID at session-start (claude is direct parent), but
# consistent with all other hooks — no drift risk.
INPUT=$(cat)
SESSION_ID="$(resolve_session_id)"

# Write to CLAUDE_ENV_FILE so it persists for all Bash calls this session
if [ -n "$CLAUDE_ENV_FILE" ]; then
    echo "export PLAYBOOK_SESSION_ID=$SESSION_ID" >> "$CLAUDE_ENV_FILE"
fi

# Auto-provision .claude/bin/ wrappers for playbook projects
PROJECT_DIR=$(find_project_root)
if [ -n "$PROJECT_DIR" ]; then
    AGENT_DIR=$(resolve_agent_dir "$PROJECT_DIR")
    create_wrapper "$PROJECT_DIR" tasks
    create_wrapper "$PROJECT_DIR" sandbox
    # Provider launchers — so existing projects pick up .claude/bin/playbook-<x>
    # on next session start, not just on fresh init.
    create_wrapper "$PROJECT_DIR" playbook-codex
    create_wrapper "$PROJECT_DIR" playbook-agy
    create_wrapper "$PROJECT_DIR" playbook-grok
    create_wrapper "$PROJECT_DIR" playbook-pi

    # Provision session directory for this session — unless this is a fresh
    # clone of a multi-user repo, where AGENT_DIR is the shared root and
    # provisioning would mint a phantom lane beside the real ones. Warn instead
    # of exiting: session start is where the user can actually see and fix it.
    LANES_NO_MARKER=$(lanes_without_marker "$PROJECT_DIR" | tr '\n' ' ')
    if [ -n "$LANES_NO_MARKER" ]; then
        {
            echo "[playbook] WARNING: per-user lanes exist but .agent/current_user is missing."
            echo "           Lane(s): ${LANES_NO_MARKER% }"
            echo "           The marker is gitignored, so a clone never receives it. Until you"
            echo "           pick a lane, session state is NOT being recorded and gate"
            echo "           enforcement will treat every edit as having no active task:"
            echo ""
            echo "               echo '<your-username>' > \"$PROJECT_DIR/.agent/current_user\""
            echo ""
        } >&2
    else
        SESSION_DIR="$AGENT_DIR/sessions/$SESSION_ID"
        mkdir -p "$SESSION_DIR"
        # F19: bind the session to its OWN transcript from the very first
        # moment (state-echo refreshes it per tool call thereafter) — the
        # monitor reads this pointer instead of guessing newest-by-mtime.
        TRANSCRIPT_PATH=$(echo "$INPUT" | python3 -c "
import sys, json
t = json.loads(sys.stdin.read()).get('transcript_path', '')
print(t if isinstance(t, str) and t and '\n' not in t and '\r' not in t else '')
" 2>/dev/null || echo "")
        if [ -n "$TRANSCRIPT_PATH" ]; then
            printf '%s\n' "$TRANSCRIPT_PATH" > "$SESSION_DIR/transcript_path" 2>/dev/null || true
        fi
    fi

    # GC: sweep session dirs from crashed/killed sessions.
    #
    # CANONICAL POLICY LIVES IN `tasks/shared.py::_gc_dead_sessions` — this is its
    # bash twin, and the two MUST agree. Both run against the same directory:
    # this one at SessionStart, that one at every CLI invocation.
    #
    # Until v1.4.6 this swept purely on `current_state` mtime, with no liveness
    # check and no self-exclusion — and `current_state` is written ONLY by
    # `tasks work <N>` (activation), never refreshed by activity. So its mtime
    # means "when the task was activated", which the sweep misread as "when the
    # session was last alive": any task active >24h had its own pointer deleted
    # at the next SessionStart, silently revoking code-edit permission mid-task
    # (task-gate-hook then hard-blocks Edit/Write). SessionStart is registered
    # with no matcher, so it also fires on `compact` — long sessions re-rolled
    # the dice at every compaction. Field-reported 2026-07-29; task 027.
    #
    # Policy, in order (mirrors _gc_dead_sessions exactly):
    #   1. never our own session — mtime is irrelevant, we are demonstrably alive
    #   2. `pid-*` (ALL of them, numeric or not): keep iff `kill -0` succeeds.
    #      A non-numeric suffix (e.g. a non-own `pid-win-fallback`) fails kill
    #      and is removed — matching Python's ValueError→remove arm.
    #   3. anything else (legacy UUIDs, "default"): 24h `current_state` mtime.
    SESSIONS_DIR="$AGENT_DIR/sessions"
    if [ -d "$SESSIONS_DIR" ]; then
        for d in "$SESSIONS_DIR"/*; do
            # NO trailing slash in the glob, and symlinks are skipped outright:
            # `rm -rf "link/"` follows the link and destroys the TARGET (measured
            # on macOS: the target directory itself was removed and the symlink
            # left behind). Python's shutil.rmtree refuses a symlink, so skipping
            # also keeps the two sweepers in agreement. Nothing legitimately
            # creates symlinks in here.
            [ -L "$d" ] && continue
            [ -d "$d" ] || continue      # stray files, and the unmatched-glob literal
            name="${d##*/}"              # no basename fork — runs at every session start

            # (1) Never sweep our own session.
            [ "$name" = "$SESSION_ID" ] && continue

            case "$name" in
                pid-*)
                    # (2w) Windows/MSYS: KEEP every pid-* dir, never probe. This
                    # mirrors tasks/shared.py::_session_is_dead under _ON_WINDOWS,
                    # which stopped probing on Windows because `kill -0` there is
                    # both unsafe (routes through TerminateProcess) and unreliable
                    # (git-bash MSYS pids do not map to native pids). Leaving this
                    # sweep probing while the Python sweeper kept-all was a parity
                    # break: `kill -0 $PPID` gives non-deterministic answers under
                    # MSYS depending on process ancestry, so this hook would delete
                    # a LIVE foreign session on some runs and not others (the
                    # wrapper-multiuser S18 271/2-vs-273/0 split in CI). Over-keeping
                    # is safe (no data loss); an unprovable-dead pid is never
                    # reclaimed. Legacy (non-pid) names still use the mtime fallback.
                    case "$(uname -s 2>/dev/null)" in
                        MINGW*|MSYS*|CYGWIN*) continue ;;
                    esac
                    # (2) Liveness, not mtime. A busy session's pointer can be
                    # arbitrarily old; a dead session's can be seconds fresh.
                    #
                    # EPERM means the process EXISTS but belongs to another OS
                    # user — alive, so keep it. Treating that as dead would be a
                    # cross-user regression: the old mtime-only sweep kept such a
                    # session, and this sweep also runs in the no-lane-marker
                    # branch above, where AGENT_DIR can be a shared root rather
                    # than a per-user lane. Only "no such process" is dead.
                    if kill_err="$(kill -0 "${name#pid-}" 2>&1)"; then
                        continue                     # alive — keep
                    fi
                    case "$kill_err" in
                        *"not permitted"*|*"Not permitted"*|*"Operation not permitted"*)
                            continue ;;              # alive, other user — keep
                    esac
                    ;;
                *)
                    # (3) Legacy non-PID names: 24h mtime fallback. `-mtime -1`
                    # = modified within 24h (BSD and GNU agree). Exact-boundary
                    # rounding differs slightly from Python's epoch cutoff —
                    # documented tolerance, legacy-only (task 027 Parked).
                    [ -n "$(find "$d" -maxdepth 1 -name current_state -mtime -1 2>/dev/null)" ] && continue
                    ;;
            esac

            # Fail-open: this hook runs under `set -e`, so an undeletable dir
            # (perms, read-only mount) must not abort session start.
            rm -rf "$d" 2>/dev/null || true
        done
    fi

    # GC: sweep aged wrapper temps left by a create_wrapper killed between its
    # write and its atomic rename (>24h so a live writer's fresh tmp is never hit).
    if [ -d "$PROJECT_DIR/.claude/bin" ]; then
        find "$PROJECT_DIR/.claude/bin" -maxdepth 1 -name '*.tmp.*' -mtime +0 \
            -delete 2>/dev/null || true
    fi
fi

exit 0
