#!/bin/bash
# task-gate-hook
# PreToolUse hook — guards:
#   0. Write — block creating new task.md files (only tasks new CLI does that)
#   1. Edit/Write on code files blocked when no task is active (exit 2 = BLOCK)
#   2-mkdir. Bash — block manual task directory creation
#
# Allows: .agent/, .claude/ edits (task management, hook config)

set -e

# Skip when invoked from the monitor's own claude session (see launch-monitor).
# Log to stderr so the hook's firing is still visible; only gate-enforcement skipped.
if [ "${PLAYBOOK_ROLE:-}" = "monitor" ]; then
    echo "[$(basename "$0")] skip (PLAYBOOK_ROLE=monitor)" >&2
    exit 0
fi

# Source shared lib (same directory)
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$HOOK_DIR/gate-echo-lib.sh"

# is_code_file_path is defined in gate-echo-lib.sh (sourced above) so the codex
# parity test can source it in isolation — see tests/test_gate_classifier_parity.py.

# Find project root
PROJECT_DIR=$(find_project_root)
if [ -z "$PROJECT_DIR" ]; then
    cat > /dev/null
    exit 0
fi

# Self-heal any 0-byte wrapper before the tool (esp. a Bash `tasks …` call) runs,
# so a launcher a pre-fix kill left empty repairs itself on the very invocation
# that needs it — not one tool call later. `|| true` so it can't trip `set -e`
# or abort in a read-only sandbox.
heal_empty_wrappers "$PROJECT_DIR" || true

# I1: a malformed .agent/current_user makes resolve_agent_dir `exit 1`. At top
# level under `set -e` that aborted the whole hook with exit 1 — which Claude
# Code treats as a NON-blocking error, so the code edit proceeded (the enforcing
# gate failed OPEN). Detect the failure and FAIL CLOSED below (block code edits)
# instead of aborting-open, while still allowing .agent/.claude edits so the
# marker stays fixable. Never falls back to shared-root state for authorization.
if ! AGENT_DIR=$(resolve_agent_dir "$PROJECT_DIR" 2>/dev/null); then
    MARKER_INVALID=true
    AGENT_DIR="$PROJECT_DIR/.agent"   # nominal for path building; guards fail closed
else
    MARKER_INVALID=false
fi

# State file lives in per-session subdirectory; "default" used when no session_id
SESSION_DIR="$AGENT_DIR/sessions/default"
STATE_FILE="$SESSION_DIR/current_state"
CLAUDE_MD="$PROJECT_DIR/CLAUDE.md"

# CLAUDE.md keyword check — warn if task system exists but CLAUDE.md doesn't mention it
if [ -d "$AGENT_DIR/tasks" ] && [ -f "$CLAUDE_MD" ]; then
    if ! grep -qE 'tasks bootstrap|tasks work' "$CLAUDE_MD" 2>/dev/null; then
        cat >&2 <<'MSG'
WARNING: CLAUDE.md doesn't mention the task system. Essential commands:
  .claude/bin/tasks bootstrap          — load context
  .claude/bin/tasks work <N>           — activate task
  .claude/bin/tasks work done          — deactivate
  .claude/bin/tasks new <type> <name>  — create task
  .claude/bin/tasks list               — see all tasks
MSG
    fi
fi

# Read stdin (PreToolUse JSON)
INPUT=$(cat)

block_unreadable_payload() {
    cat >&2 <<'MSG'
BLOCKED: The enforcing task gate could not read a complete tool payload.

No authorization decision can be made from missing or malformed fields.
Retry the tool call after restoring python3/the Playbook hook scripts.
MSG
    exit 2
}

# Normalize provider payload dialects (grok camelCase + renamed tools →
# claude snake_case; identity for claude payloads). An enforcing read retries
# independent extraction after a fused failure and blocks if the payload stays
# unreadable. See scripts/hook-payload-normalize.py (task 014).
# --emit-fields does the normalize AND every field this hook needs in that same
# one process: tool_name, the tool-specific path, its lexical
# normpath, and the command. Before, each was its own `python3 -c` — four
# interpreter starts per tool call parsing the same JSON three times. Records
# are NUL-delimited because a command or path may contain newlines. The sentinel
# distinguishes "the fused read ran" from "python is missing / the script died";
# without it we fall through to the original per-field extraction below, because
# an ENFORCING gate must never mistake an unreadable payload for an empty one.
PB_FUSED=""
PB_SENTINEL=""
PB_PAYLOAD=""
TOOL_NAME=""
FILE_PATH=""
NORM_PATH=""
PB_CMD=""
PB_TRANSCRIPT=""
PB_FRAME_COMPLETE=true
{
    IFS= read -r -d '' PB_SENTINEL   || PB_FRAME_COMPLETE=false
    IFS= read -r -d '' TOOL_NAME     || PB_FRAME_COMPLETE=false
    IFS= read -r -d '' FILE_PATH     || PB_FRAME_COMPLETE=false
    IFS= read -r -d '' NORM_PATH     || PB_FRAME_COMPLETE=false
    IFS= read -r -d '' PB_CMD        || PB_FRAME_COMPLETE=false
    IFS= read -r -d '' PB_TRANSCRIPT || PB_FRAME_COMPLETE=false
    IFS= read -r -d '' PB_PAYLOAD    || PB_FRAME_COMPLETE=false
} < <(printf '%s' "$INPUT" | python3 "$HOOK_DIR/hook-payload-normalize.py" --emit-fields 2>/dev/null) || true

if [ "$PB_SENTINEL" = "pb-fields-v2" ] && [ "$PB_FRAME_COMPLETE" = true ]; then
    PB_FUSED=1
    INPUT="$PB_PAYLOAD"
else
    # Recovery path: normalize, then extract every field independently.  A
    # producer that emitted only a sentinel/partial frame must never turn an
    # Edit into empty truth.  Any decode/extraction failure blocks: this is the
    # enforcing hook, and unreadable input cannot authorize work.
    # dialects (grok camelCase + renamed tools → claude snake_case; identity for
    # claude payloads), then read the fields the guards below need up front.
    TOOL_NAME=""; FILE_PATH=""; NORM_PATH=""; PB_CMD=""
    NORMALIZED=""
    if NORMALIZED=$(printf '%s' "$INPUT" | python3 "$HOOK_DIR/hook-payload-normalize.py" 2>/dev/null) \
       && [ -n "$NORMALIZED" ]; then
        INPUT="$NORMALIZED"
    fi
    if ! TOOL_NAME=$(printf '%s' "$INPUT" | python3 -c \
        "import sys,json; d=json.load(sys.stdin); v=d.get('tool_name',''); sys.stdout.write(v if isinstance(v,str) else '')" \
        2>/dev/null); then
        block_unreadable_payload
    fi
    if ! FILE_PATH=$(printf '%s' "$INPUT" | python3 -c \
        "import sys,json; d=json.load(sys.stdin); ti=d.get('tool_input',{}); ti=ti if isinstance(ti,dict) else {}; t=d.get('tool_name',''); v=ti.get('notebook_path','') if t == 'NotebookEdit' else ti.get('file_path',''); sys.stdout.write(v if isinstance(v,str) else '')" \
        2>/dev/null); then
        block_unreadable_payload
    fi
    if ! NORM_PATH=$(FP="$FILE_PATH" python3 -c \
        "import os,sys; sys.stdout.write(os.path.normpath(os.environ['FP']))" \
        2>/dev/null); then
        block_unreadable_payload
    fi
    if ! PB_CMD=$(printf '%s' "$INPUT" | python3 -c \
        "import sys,json; d=json.load(sys.stdin); ti=d.get('tool_input',{}); ti=ti if isinstance(ti,dict) else {}; v=ti.get('command',''); sys.stdout.write(v if isinstance(v,str) else '')" \
        2>/dev/null); then
        block_unreadable_payload
    fi
    # Downstream branches may reuse the successfully recovered fields exactly
    # like fused fields; the value denotes "fields ready", not wire provenance.
    PB_FUSED=fallback
fi

# A valid hook call always names a tool.  Empty/whitespace/wrong-typed names are
# schema failures, not evidence that the call is harmless.
if [[ ! "$TOOL_NAME" =~ [^[:space:]] ]]; then
    block_unreadable_payload
fi
case "$TOOL_NAME" in
    Edit|Write|MultiEdit|NotebookEdit)
        [[ "$FILE_PATH" =~ [^[:space:]] ]] || block_unreadable_payload
        ;;
    Bash)
        [[ "$PB_CMD" =~ [^[:space:]] ]] || block_unreadable_payload
        ;;
esac

# Session ID: env var → ancestor-scan → pid-$PPID (see gate-echo-lib.sh::resolve_session_id)
SESSION_ID="$(resolve_session_id)"

SESSION_DIR="$AGENT_DIR/sessions/$SESSION_ID"
STATE_FILE="$SESSION_DIR/current_state"
# Fresh-clone shape: AGENT_DIR is the shared root and creating the session dir
# there mints a phantom lane. Skip the mkdir — STATE_FILE then simply doesn't
# exist, which the guards below already read as "no active task" (fail-closed,
# the correct answer when we cannot tell whose lane this is). Never exit here:
# a hook that aborts takes the whole session down.
if [ -z "$(lanes_without_marker "$PROJECT_DIR")" ]; then
    # NEW-2: guard the mkdir — under `set -e` an unwritable/full (ENOSPC,
    # read-only, wrong-perms) sessions dir made this abort with exit 1, a
    # NON-blocking code, so the ENFORCING gate stopped enforcing globally
    # (code edits proceeded). Fail-safe: on failure STATE_FILE simply won't
    # exist, which the guards below already read as "no active task" (block).
    # Mirrors the guard the non-enforcing state-echo hook already had.
    mkdir -p "$SESSION_DIR" 2>/dev/null || true
fi

# --- Eval mode: skip guards if pretool_guard=off (keep session injection in Guard 2) ---
if [ -n "$PLAYBOOK_EVAL_CONFIG" ] && [ -f "$PLAYBOOK_EVAL_CONFIG" ]; then
    EVAL_PRETOOL=$(python3 -c "import json; print(json.loads(open('$PLAYBOOK_EVAL_CONFIG').read()).get('pretool_guard','on'))" 2>/dev/null || echo "on")
    if [ "$EVAL_PRETOOL" = "off" ]; then
        # Skip all guards, jump straight to Guard 2 (Bash session injection)
        if [ "$TOOL_NAME" = "Bash" ]; then
            if [ -n "$PB_FUSED" ]; then CMD="$PB_CMD"; else
            CMD=$(echo "$INPUT" | python3 -c "import sys,json; print(json.load(sys.stdin).get('tool_input',{}).get('command',''))" 2>/dev/null || echo "")
            fi
            if echo "$CMD" | grep -qE 'tasks\s+(work|status|bootstrap|freehand|retro|new)' && [ -n "$SESSION_ID" ]; then
                UPDATED_CMD="export PLAYBOOK_SESSION_ID=$SESSION_ID; $CMD"
                JSON_CMD=$(python3 -c "import json; print(json.dumps('$UPDATED_CMD'))" 2>/dev/null)
                cat <<EOF
{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"allow","updatedInput":{"command":${JSON_CMD}}}}
EOF
                exit 0
            fi
        fi
        echo '{}'; exit 0
    fi
fi

# --- Guard 0: Write — block creating new task.md files (only tasks new CLI does that) ---
if [ "$TOOL_NAME" = "Write" ]; then
    if [ -z "$PB_FUSED" ]; then
        FILE_PATH=$(echo "$INPUT" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('tool_input',{}).get('file_path',''))" 2>/dev/null || echo "")
    fi

    # Check if it's a task.md in .agent/tasks/ that doesn't exist yet
    if echo "$FILE_PATH" | grep -qE '\.agent(/[^/]+)?/tasks/[^/]+/task\.md$'; then
        if [ ! -f "$FILE_PATH" ]; then
            cat >&2 <<'MSG'
BLOCKED: Only `.claude/bin/tasks new` creates task.md files.

Don't create task files manually. The CLI enforces templates and numbering.

Use:  .claude/bin/tasks new <type> <name>
Types: audit, bugfix, build, cleanup, eval, feature, light, ops, quick, refactor, research (run `tasks new` to see the current set)
MSG
            exit 2
        fi
    fi
fi

# --- Guard 0.5: annotated batch-close (v2 — F1, blind-judge-reviewed) ---
# v1 blocked 3+ newly-checked gates per write and warned at 2 — the field's
# "checkbox tax" (6/6 journals). v2 moves the lever from "one gate per edit"
# to "every closed gate carries its own outcome evidence": batches of 2-5
# annotated closes are allowed, bare/sub-floor batches BLOCK (tightened from
# the old warn-at-2), 6+ blocks even annotated, born-checked lines block,
# and two batch closes with no tool call between them block the second.
# Logic lives in gate-batch-check.py (shared, testable); the helper fails
# OPEN on its own errors — only an explicit exit 2 blocks.
# Must run BEFORE the .agent/* early-exit in Guard 1.
if [ "$TOOL_NAME" = "Edit" ] || [ "$TOOL_NAME" = "Write" ]; then
    # Extract file_path (reuse from Guard 0 for Write, extract for Edit)
    if [ -z "$FILE_PATH" ] && [ -z "$PB_FUSED" ]; then
        FILE_PATH=$(echo "$INPUT" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('tool_input',{}).get('file_path',''))" 2>/dev/null || echo "")
    fi

    # Check if this targets the active task's task.md
    if [ -f "$STATE_FILE" ] && echo "$FILE_PATH" | grep -qE '\.agent(/[^/]+)?/tasks/[^/]+/task\.md$'; then
        ACTIVE_TASK=$(head -1 "$STATE_FILE" | tr -d '[:space:]')
        if [ -n "$ACTIVE_TASK" ] && echo "$FILE_PATH" | grep -q "/${ACTIVE_TASK}-"; then
            BATCH_RC=0
            BATCH_MSG=$(echo "$INPUT" | python3 "$HOOK_DIR/gate-batch-check.py" \
                --tool "$TOOL_NAME" --file "$FILE_PATH" \
                --session-dir "$SESSION_DIR" 2>/dev/null) || BATCH_RC=$?
            if [ "$BATCH_RC" = "2" ]; then
                echo "$BATCH_MSG" >&2
                exit 2
            fi
        fi
    fi
fi

# --- Guard 1: Edit/Write/MultiEdit/NotebookEdit — require active task for code files ---
# I13: MultiEdit (file_path) and NotebookEdit (notebook_path) edit code too, but
# were omitted from the matcher AND this guard, so a no-task edit through them
# was never gated. `.ipynb` is now in is_code_file_path as well.
if [ "$TOOL_NAME" = "Edit" ] || [ "$TOOL_NAME" = "Write" ] \
   || [ "$TOOL_NAME" = "MultiEdit" ] || [ "$TOOL_NAME" = "NotebookEdit" ]; then
    # Reuse FILE_PATH from Guard 0/0.5 if already set; else read file_path OR
    # notebook_path (NotebookEdit uses the latter).
    if [ -z "$FILE_PATH" ] && [ -z "$PB_FUSED" ]; then
        FILE_PATH=$(echo "$INPUT" | python3 -c "import sys,json; d=json.load(sys.stdin).get('tool_input',{}); print(d.get('file_path','') or d.get('notebook_path',''))" 2>/dev/null || echo "")
    fi

    # NEW-1: resolve `..` BEFORE the .agent/.claude exemption. A path that merely
    # CONTAINS the token but traverses back out to a code file
    # (`.agent/../src/main.py`) must not be exempted — it used to be, while the
    # write landed on the real code file, bypassing the gate. Lexical normpath
    # only (no filesystem/symlink resolution → no TOCTOU); judge both the
    # exemption AND the code-file test on the resolved path.
    if [ -z "$PB_FUSED" ]; then
        NORM_PATH=$(FP="$FILE_PATH" python3 -c "import os; print(os.path.normpath(os.environ['FP']))" 2>/dev/null || echo "$FILE_PATH")
    fi

    # Allow .agent/ and .claude/ edits (task management, hook config)
    case "$NORM_PATH" in
        */.agent/*|*/.claude/*) exit 0 ;;
    esac

    # Only block code files
    if ! is_code_file_path "$NORM_PATH"; then
        exit 0
    fi

    # I1: malformed marker — FAIL CLOSED. We cannot resolve which lane owns the
    # tasks, so no code edit is authorized (.agent/.claude edits were already
    # allowed above, so the marker stays fixable).
    if [ "${MARKER_INVALID:-false}" = true ]; then
        cat >&2 <<'MSG'
BLOCKED: .agent/current_user is malformed — cannot resolve your lane.
Fix it to a single username line (letters, digits, and ._- only), e.g.:
  echo alice > .agent/current_user
Code edits are blocked until the lane resolves.
MSG
        exit 2
    fi

    # Check for active task — the pointer must RESOLVE to a real task dir, not
    # merely be non-empty (I2). `.agent/**` is gate-exempt, so an agent could
    # `Write current_state=junk` and self-authorize; this also fires on a
    # stale/leftover pointer whose task dir was renamed or deleted. Same
    # NNN-*/task.md resolution the state-echo/stop hooks use.
    if [ -f "$STATE_FILE" ]; then
        TASK=$(head -1 "$STATE_FILE" | tr -d '[:space:]')
        # N2: the pointer feeds a `find -path "*/${TASK}-*/*"` GLOB, so a bare
        # glob metacharacter (`*`, `?`, `[…]`) in the gate-exempt current_state
        # matched a real task and self-authorized. Task pointers are numeric —
        # reject anything non-digit before it reaches the glob.
        case "$TASK" in
            ''|*[!0-9]*) ;;   # empty or non-digit → not a valid pointer; fall through to block
            *)
                RESOLVED=$(find "$AGENT_DIR/tasks" -maxdepth 2 -name "task.md" \
                    -path "*/${TASK}-*/*" 2>/dev/null | head -1)
                if [ -n "$RESOLVED" ]; then
                    # F3 (defense in depth): a pointer that resolves to a DONE
                    # task must not keep the gate open. Normal close clears the
                    # pointer, so this only fires on a stale/hand-written pointer
                    # to a closed task — `tasks work <N>` reopens it (status →
                    # in_progress) before any edit, so a real resume is unaffected.
                    # An unparsable/absent status is NOT "done" → authorize (fail
                    # toward today's behavior, never a new false block).
                    STATUS=$(awk '
                        {gsub(/\r/,"")}
                        flag {status=$0; flag=0}
                        /^[[:space:]]*## Status[[:space:]]*$/ {flag=1}
                        END {print status}
                    ' "$RESOLVED" | tr -d '[:space:]')
                    # Match the CLI authority core._is_done (status STARTS WITH
                    # "done", so "done (2026-…)" counts) and tolerate an indented
                    # ## Status header like core._extract_status. Empty/unparsable
                    # or any active status → authorize (never a new false block).
                    case "$STATUS" in
                        done*) ;;      # done task → fall through to BLOCK
                        *) exit 0 ;;   # active (or unreadable) → authorize
                    esac
                fi
                ;;
        esac
    fi

    # No active task — block code edit
    cat >&2 <<'MSG'
BLOCKED: No active task.

Code edits require an active task so work is tracked and directed.

Workflow:
  1. .claude/bin/tasks new <type> <name>   — create task
  2. .claude/bin/tasks work <N>            — activate immediately (don't wait)
  3. ... do the work gate by gate ...
  4. .claude/bin/tasks work done           — deactivate when finished

To resume an existing task:  .claude/bin/tasks work <N>
MSG
    exit 2
fi

# --- Guard 2: Bash — inject session_id + block manual task dir creation ---
if [ "$TOOL_NAME" = "Bash" ]; then
    if [ -n "$PB_FUSED" ]; then CMD="$PB_CMD"; else
    CMD=$(echo "$INPUT" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('tool_input',{}).get('command',''))" 2>/dev/null || echo "")
    fi

    # Guard 3: judge session — block task management commands. MUST run BEFORE
    # the injection early-exit below (I3): `tasks new`/`tasks work` also match
    # the injection pattern, so with the old order the injection allowed and
    # exited 0 first, and this block was dead code — a judge session could
    # create/activate tasks.
    if [ "$SESSION_ID" = "judge" ] && echo "$CMD" | grep -qE '(^|[;&|] *)(([^ ]*/)?)tasks (new|work)'; then
        cat >&2 <<'MSG'
BLOCKED: Judge session cannot create or activate tasks.

The judge reviews plans — it doesn't manage tasks.
MSG
        exit 2
    fi

    # Inject PLAYBOOK_SESSION_ID into tasks CLI commands via updatedInput
    if [ -n "$SESSION_ID" ] && echo "$CMD" | grep -qE '(^|[;&|] *)(([^ ]*/)?)tasks (work|status|bootstrap|freehand|retro|new)'; then
        UPDATED_CMD="export PLAYBOOK_SESSION_ID=$SESSION_ID; $CMD"
        JSON_CMD=$(echo "$UPDATED_CMD" | python3 -c "import sys,json; print(json.dumps(sys.stdin.read().rstrip()))" 2>/dev/null)
        cat <<EOFX
{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"allow","updatedInput":{"command":${JSON_CMD}}}}
EOFX
        exit 0
    fi

    if echo "$CMD" | grep -qE 'mkdir.*\.agent(/[^/]+)?/tasks/'; then
        cat >&2 <<'MSG'
BLOCKED: Don't create task directories manually.

Use `.claude/bin/tasks new <type> <name>` to create tasks. The CLI enforces templates and numbering.

Types: audit, bugfix, build, cleanup, eval, feature, light, ops, quick, refactor, research (run `tasks new` to see the current set)
MSG
        exit 2
    fi
fi

# Everything else — allow
exit 0
