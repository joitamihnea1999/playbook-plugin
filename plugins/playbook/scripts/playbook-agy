#!/bin/bash
# bin/playbook-agy — launch Antigravity CLI (agy) with a per-session Playbook ID.
#
# Usage: playbook-agy [agy-args...]
#
# Generates PLAYBOOK_SESSION_ID, provisions the session directory, then execs
# agy so the agent inherits the env. GEMINI.md in the project root carries
# workflow instructions; install_hooks (`tasks init --provider antigravity --hooks`)
# registers a global agy plugin that wires PreToolUse/PostToolUse/UserPromptSubmit/
# Stop hooks via `agy plugin install`.
#
# Canonical user-facing entry point. See src/provider/adapters/antigravity.py
# launch_interactive() for the programmatic equivalent (assumes env pre-set).

set -e

case "${1:-}" in
    -h|--help)
        cat <<'EOF'
Usage: playbook-agy [agy-args...]

Launch Antigravity with Playbook's project/session environment. All arguments
are forwarded to agy. This help path performs no project or session writes.
EOF
        exit 0
        ;;
esac

# Playbook runtime is stdlib-only — any python3 ≥ 3.10 works. This launcher and
# every hook the agy session spawns need it; refuse < 3.10 up front with a clear
# message instead of a parser traceback mid-session. (--help above is python-free.)
# See CLAUDE.md "Runtime invariant" and memory project-stdlib-only-runtime.
python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3,10) else 1)' 2>/dev/null \
    || { echo "Playbook needs python3 >= 3.10 (found: $(python3 --version 2>&1))" >&2; exit 1; }

# Root + lane resolution come from the shared hook library — never re-vendored
# here. A wrapper that walks for `.agent/tasks/` alone is blind to the
# multi-user layout (`.agent/<user>/tasks/`) and provisions the wrong lane.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
if [ -f "$SCRIPT_DIR/gate-echo-lib.sh" ]; then
    LIB_DIR="$SCRIPT_DIR"
elif [ -f "$SCRIPT_DIR/../scripts/gate-echo-lib.sh" ]; then
    LIB_DIR="$(cd "$SCRIPT_DIR/../scripts" && pwd -P)"
else
    echo "Error: cannot locate Playbook hook library (gate-echo-lib.sh) near $SCRIPT_DIR" >&2
    echo "Reinstall the plugin, or run agy directly if you meant to skip gate enforcement." >&2
    exit 1
fi
# shellcheck source=/dev/null
source "$LIB_DIR/gate-echo-lib.sh"

PROJECT_ROOT="$(find_project_root)"

# Fail loud rather than provision a phantom root lane on a fresh clone.
require_lane_marker "$PROJECT_ROOT" "playbook-agy"

# PID-based session ID: pid-$$ (this wrapper's PID = parent of agy process)
SESSION_ID="pid-$$"
export PLAYBOOK_SESSION_ID="$SESSION_ID"
export PLAYBOOK_PROJECT_ROOT="$PROJECT_ROOT"

# Provision session directory so state files have a home — in the SAME lane the
# hooks and the tasks CLI read (invalid marker exits 1 via set -e).
if [ -n "$PROJECT_ROOT" ]; then
    AGENT_DIR="$(resolve_agent_dir "$PROJECT_ROOT")"
    mkdir -p "$AGENT_DIR/sessions/$SESSION_ID"
fi

exec agy "$@"
