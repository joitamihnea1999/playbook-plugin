+    ).toThrowError(EnvError);
+  });
+});
+
+describe("tilesPmtilesPath", () => {
+  it("defaults to <cwd>/data/tiles/bucharest.pmtiles", () => {
+    expect(tilesPmtilesPath({})).toBe(`${process.cwd()}/data/tiles/bucharest.pmtiles`);
+  });
+  it("uses an absolute override verbatim", () => {
