#!/bin/bash
# launch-monitor — start claude as the conversation monitor, sandboxed
#
# Containment via provider.sandbox (Darwin seatbelt / Linux bwrap):
#   - project read-only, <agent-dir>/monitor/ the only project-side writable
#   - plugin hooks disabled at the source via claude --safe-mode
#
# Usage:
#   .claude/bin/monitor start                           (auto-detect oldest alive pid)
#   .claude/bin/monitor start --session-id pid-29309    (explicit override)

set -e

MONITOR_SRC="$(cd "$(dirname "$0")" && pwd)"

# Shared root + lane resolution (same library the hooks use), so the monitor
# agrees with the front agent about which `.agent/<user>/` lane is live.
if [ -f "$MONITOR_SRC/../gate-echo-lib.sh" ]; then
    # shellcheck source=/dev/null
    source "$MONITOR_SRC/../gate-echo-lib.sh"
else
    echo "Error: cannot locate gate-echo-lib.sh next to $MONITOR_SRC" >&2
    exit 1
fi

# When shipped via plugin, $MONITOR_SRC lives in plugin cache — its ../../
# would point into the plugin, not at the user's project. Use caller's $PWD
# (inherited through .claude/bin/monitor wrapper) or explicit env var.
# find_project_root walks up, so launching from a subdirectory still resolves
# the project (a bare $PWD would silently monitor the wrong tree).
PROJECT_DIR="${PLAYBOOK_PROJECT_DIR:-}"
if [ -z "$PROJECT_DIR" ]; then
    PROJECT_DIR="$(find_project_root)"
    [ -n "$PROJECT_DIR" ] || PROJECT_DIR="$PWD"
fi
# Refuse on the fresh-clone shape: the monitor mkdirs its state dir, so an
# unguarded launch mints a phantom root lane. This is an interactive command,
# so failing loud is right here (unlike the hooks, which must skip quietly).
require_lane_marker "$PROJECT_DIR" "launch-monitor"
AGENT_DIR="$(resolve_agent_dir "$PROJECT_DIR")"

# --- Parse --session-id ---
SESSION_ID="${PLAYBOOK_SESSION_ID:-}"
ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --session-id)      SESSION_ID="$2";           shift 2 ;;
        --session-id=*)    SESSION_ID="${1#*=}";      shift ;;
        *)                 ARGS+=("$1");              shift ;;
    esac
done

# Filter to alive pid-* dirs (kill -0 + ps comm contains "claude").
# Picks oldest by ctime. Exits on 0 alive or 2+ alive (no heuristic
# to pick the "real" main agent — user must disambiguate via --session-id).
find_main_session() {
    local sessions_dir="$AGENT_DIR/sessions"
    # A missing sessions dir is the same user-facing situation as an empty one:
    # nothing is running. `return 1` here used to kill the script via `set -e`
    # before the message below was ever printed — exit 1 with no explanation.
    if [ ! -d "$sessions_dir" ]; then
        echo "Error: no main agent running (no alive pid-* under $sessions_dir/)" >&2
        exit 1
    fi

    local alive=()
    while IFS= read -r name; do
        [ -n "$name" ] || continue
        local pid="${name#pid-}"
        if kill -0 "$pid" 2>/dev/null && ps -p "$pid" -o comm= 2>/dev/null | grep -q claude; then
            alive+=("$name")
        fi
    done < <(ls -1 "$sessions_dir" 2>/dev/null | grep -E '^pid-[0-9]+$' || true)

    local count="${#alive[@]}"
    if [ "$count" = "0" ]; then
        echo "Error: no main agent running (no alive pid-* under $AGENT_DIR/sessions/)" >&2
        exit 1
    fi
    if [ "$count" = "1" ]; then
        SESSION_ID="${alive[0]}"
        echo "[launch-monitor] auto-detected session: $SESSION_ID" >&2
        return 0
    fi
    # 2+: pick oldest by ctime (tiebreak unlikely but sort keeps it stable)
    SESSION_ID=""
    local best_ts=""
    for name in "${alive[@]}"; do
        local ts
        ts=$(stat -f '%B' "$sessions_dir/$name" 2>/dev/null || stat -c '%W' "$sessions_dir/$name" 2>/dev/null)
        if [ -z "$best_ts" ] || [ "$ts" -lt "$best_ts" ]; then
            best_ts="$ts"
            SESSION_ID="$name"
        fi
    done
    echo "Warning: multiple active sessions found — picking oldest ($SESSION_ID). Override with --session-id:" >&2
    printf '  %s\n' "${alive[@]}" >&2
}

if [ -z "$SESSION_ID" ]; then
    find_main_session
fi

# Validate SESSION_ID — path traversal guard.
if ! echo "$SESSION_ID" | grep -Eq '^pid-[0-9]+$'; then
    echo "Error: invalid SESSION_ID '$SESSION_ID' (expected pid-<digits>)" >&2
    exit 2
fi

# MONITOR_DIR lives in the TARGET project's agent dir, not the plugin.
# Flat layout (T121): single state dir, not per-pid subdirs. Lane-resolved, so
# each user on a shared repo gets their own monitor state.
MONITOR_DIR="$AGENT_DIR/monitor"
mkdir -p "$MONITOR_DIR"

# --- Containment: delegate to provider.sandbox (batch-5 fix) ---
# This launcher used to hand-roll a seatbelt profile and exec the macOS
# sandbox binary directly — macOS-only, found broken on Linux by the owner
# (batch 5).
# provider.sandbox is the single source of truth for containment: Darwin
# seatbelt AND Linux bwrap, with the bind-order lesson (1.5.3 spike) encoded
# once. Monitor containment model, expressed in its terms:
#   --ro-project           project (incl. sessions/, chat_log.md, tasks/,
#                          MIND_MAP.md) binds READ-ONLY
#   --rw "$MONITOR_DIR"    the one project-side writable, bound last so it
#                          stays writable inside the read-only project
# System/home areas claude's UI needs stay writable via the module's own
# allowlist (same one the judge sandbox uses).
PLUGIN_ROOT="$(cd "$MONITOR_SRC/../.." && pwd -P)"
if [ ! -d "$PLUGIN_ROOT/provider" ]; then
    echo "Error: provider/ module not found at $PLUGIN_ROOT (launch-monitor moved?)" >&2
    exit 1
fi
python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3,10) else 1)' 2>/dev/null \
    || { echo "Playbook needs python3 >= 3.10 (found: $(python3 --version 2>&1))" >&2; exit 1; }

echo "[launch-monitor] watching session: $SESSION_ID" >&2
echo "[launch-monitor] writable: $MONITOR_DIR (+ system dirs)" >&2

export PLAYBOOK_SESSION_ID="$SESSION_ID"
export PLAYBOOK_PROJECT_DIR="$PROJECT_DIR"
# Hand the resolved lane to bootstrap.sh so it never re-derives it (one
# resolver, one answer — a second copy is a second thing that can drift).
export PLAYBOOK_AGENT_DIR="$AGENT_DIR"
# Distinguish this claude session as the MONITOR, so the nudge-consume hook
# skips (would otherwise eat our own nudges before front agent sees them).
export PLAYBOOK_ROLE="monitor"
cd "$PROJECT_DIR"

# Run bootstrap.sh to produce the full briefing, then pass it as claude's
# initial user message. Claude starts interactive with context already loaded;
# the CLAUDE.md directive ("first action: run bootstrap") is effectively
# pre-satisfied, so the monitor goes straight to forming a first judgment.
BOOTSTRAP_OUT=$("$MONITOR_SRC/bootstrap.sh" 2>&1)
SEED="$BOOTSTRAP_OUT

---

That was your bootstrap output. Based on the briefing above, form your initial judgment, append to session.md (using the SESSION.MD APPEND command from the COMMANDS section), and run the WAIT COMMAND."

# --safe-mode replaces the old `--settings '{}'` shim: a settings override
# cannot suppress plugin-REGISTERED hooks (T136 — the session-start-hook this
# comment block used to guard against still fired). --safe-mode disables
# CLAUDE.md + plugins + hooks at the source; the monitor's whole briefing
# arrives via $SEED, so it loses nothing.
exec env PYTHONPATH="$PLUGIN_ROOT${PYTHONPATH:+:$PYTHONPATH}" \
    python3 -m provider.sandbox --agent claude --ro-project \
    --rw "$MONITOR_DIR" --project-root "$PROJECT_DIR" \
    -- --dangerously-skip-permissions --safe-mode "${ARGS[@]}" "$SEED"
